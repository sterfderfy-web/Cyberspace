{
  "name": "cyberspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "check": "tsc --noEmit",
    "setup": "tsx apps/server/setup.ts",
    "start": "node dist/apps/server/main.js",
    "dev": "tsx watch apps/server/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "agent": "node dist/apps/demo-agent/main.js",
    "test": "tsx --test tests/acceptance/api.test.ts tests/acceptance/process.test.ts tests/acceptance/spatial.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "@fastify/websocket": "11.3.6",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "ws": "8.22.1"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
